// Default configuration values (used by ConfigManager)
// Actual credentials are stored in NVS via ConfigPortal
// Copy this file to config.h

#ifndef CONFIG_H
#define CONFIG_H

// Default device name
const char* DEFAULT_DEVICE_NAME = "LabelPrinter";

// Default MQTT settings
const char* DEFAULT_MQTT_SERVER = "mqtt.example.com";
const uint16_t DEFAULT_MQTT_PORT = 1883;

// Hardware button configuration (F005)
const uint8_t BOOT_BUTTON_PIN = 0;              // GPIO 0 = BOOT button on most ESP32 boards
const uint32_t CONFIG_RESET_HOLD_MS = 3000;     // Hold for 3 seconds to reset config

#endif
